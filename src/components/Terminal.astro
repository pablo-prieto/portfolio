---
import { profile } from "../data/resume"

// Decorative only: static values, hidden from assistive tech.
const ticker = [
  { sym: "BTC", move: "▲2.1%", up: true },
  { sym: "ETH", move: "▲0.8%", up: true },
  { sym: "SOL", move: "▼1.3%", up: false },
]
---

<div class="frame">
  <div class="window">
    <header class="titlebar">
      <span class="dots" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="title">
        {profile.handle}@{profile.host}: {profile.cwd} — zsh
      </span>
      <span class="ticker" aria-hidden="true">
        {ticker.map(t => (
          <span>
            {t.sym} <b class:list={{ down: !t.up }}>{t.move}</b>
          </span>
        ))}
      </span>
    </header>
    <main class="body">
      <slot />
    </main>
  </div>
</div>

<style>
  .frame {
    position: relative;
    z-index: 1;
    max-width: 920px;
    margin: 48px auto;
    padding: 0 20px;
  }
  .window {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgb(10 12 11 / 0.82);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  }
  .titlebar {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
    border-radius: 10px 10px 0 0;
    font-size: 12px;
    color: var(--dim);
  }
  .dots {
    display: flex;
    gap: 8px;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .dots i:nth-child(2) {
    background: #febc2e;
  }
  .dots i:nth-child(3) {
    background: #28c840;
  }
  .title {
    flex: 1;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ticker {
    display: flex;
    gap: 14px;
    white-space: nowrap;
  }
  .ticker b {
    color: var(--green);
    font-weight: 400;
  }
  .ticker b.down {
    color: var(--red);
  }
  .body {
    padding: 28px 30px 60px;
  }
  @media (max-width: 640px) {
    .frame {
      margin: 0;
      padding: 0;
    }
    .window {
      border-radius: 0;
      border-inline: 0;
    }
    .titlebar {
      border-radius: 0;
    }
    .ticker {
      display: none;
    }
    .body {
      padding: 22px 16px 48px;
    }
  }
</style>
